# Copy to .env and fill in the <...> values:   copy .env.example .env   (PowerShell)
# .env is gitignored; this file is safe to commit (no secrets).

# --- LLM (provider auto-detected from key: sk-* = openai, else gemini) ---
LLM_API_KEY=<your OpenAI (sk-...) or Gemini API key>
LLM_PROVIDER=auto
# Provider-scoped overrides (blank = code default). Only the active provider's block is used,
# so swapping LLM_API_KEY between OpenAI and Gemini needs no other change.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Tried in order when the primary model is rate-limited / out of quota
GEMINI_CHAT_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_SIM_THRESHOLD=   (unset = auto-calibrated at index build; set a number to override)
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_CHAT_FALLBACKS=gpt-4.1-nano
OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_SIM_THRESHOLD=   (unset = auto-calibrated at index build)
EMBED_DIM=768
TEMPERATURE=0
MAX_OUTPUT_TOKENS=500
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
QUERY_REWRITE=false
# Cache identical (prompt, KB context, history, date) LLM calls in Postgres. Saves quota on reruns.
LLM_CACHE=true

# --- Retrieval ---
KB_DIR=../vectra_kb_articles/kb
TOP_K=3
# Rebuild the index automatically when the embedding provider/model changes (e.g. key swapped)
AUTO_REINGEST=true
# GREY_BAND=            (unset = auto-calibrated; borderline cosine band that needs keyword support)
# Conversation memory: earlier turns given as context, and how long they are kept
HISTORY_TURNS=3
CONVERSATION_TTL_MIN=120

# --- Postgres / pgvector (docker compose reads these too) ---
# Keep PG_HOST=127.0.0.1: "localhost" may resolve to IPv6 and hang on Windows.
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=rag
PG_PASSWORD=<random password, e.g. python -c "import secrets; print(secrets.token_urlsafe(24))">
PG_DB=vectra_kb
PG_POOL_MAX=10

# --- Auth / API ---
# >= 32 chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<random secret, at least 32 characters>
JWT_TTL_MIN=60
# username|role|bcrypt_hash ; roles: admin, agent, staff. Keep the single quotes (hashes contain $).
# Hash a password:  python -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt(12)).decode())"
AUTH_USERS='admin|admin|<bcrypt hash>;agent|agent|<bcrypt hash>;staff|staff|<bcrypt hash>'
RATE_LIMIT_PER_MIN=10
LOGIN_RATE_LIMIT_PER_MIN=5
# postgres = shared by all workers; memory = per process (tests)
RATE_LIMIT_BACKEND=postgres
MAX_QUESTION_CHARS=500
# Browser origins allowed to call the API: must include the frontend's origin (frontend/.env VITE_BASE_URL setup)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Swagger UI at /docs. Turn off in production.
ENABLE_DOCS=true
AUDIT_LOG=logs/audit.jsonl
