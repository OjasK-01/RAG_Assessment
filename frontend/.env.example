# Backend (FastAPI) origin, no trailing slash. The browser calls it directly, so the backend
# must list this page's origin (http://127.0.0.1:5173) in CORS_ORIGINS.
# Leave empty to use the Vite dev proxy instead (same origin, /api -> http://127.0.0.1:8000).
# Vite inlines VITE_* values into the public JS bundle: never put secrets here.
VITE_BASE_URL=http://127.0.0.1:8000
